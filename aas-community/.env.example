# ---------------------------------------------------------------------------
# AAS Community — environment configuration
#
# HARD CONSTRAINT (§1): all infrastructure and data MUST be hosted outside
# Russian jurisdiction and outside Russian data-localization reach. Choose
# non-Russian regions for the database, object store, and all managed services.
# ---------------------------------------------------------------------------

# Postgres connection string (use a non-Russian region).
DATABASE_URL="postgresql://aas:aas@localhost:5432/aas_community?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
# Base URL of the deployment (used for callbacks).
NEXTAUTH_URL="http://localhost:3000"

# OAuth providers (conventional, well-supported auth — hard constraint §1).
# Leave blank to disable a provider; email/password works without these.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Object store for archive images — S3-compatible, NON-RUSSIAN region.
# If unset, a local filesystem store under ./.uploads is used for development.
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET="aas-archive"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Verification: how many vouches from already-verified members approve a
# request automatically (default 1–2). Era-corroboration always needs admin.
VOUCH_THRESHOLD="2"

# Phase 2 gate: number of verified members before scale-dependent features
# (reunions/meetups, the feed) switch on. Gated by count, never by date (§5.1).
PHASE2_MEMBER_THRESHOLD="150"
